<?php

$numbers = array(5, -7, 12, 10, -7, 11, -6, 12, 1, -7, 2, 9);

// Print all elements
echo "All elements: ";

foreach ($numbers as $number) {
    echo $number . " ";
}

echo "<br><br>";

// Variables for totals
$total = 0;
$evenTotal = 0;
$oddTotal = 0;

// Calculate totals
foreach ($numbers as $number) {

    $total += $number;

    if ($number % 2 == 0) {
        $evenTotal += $number;
    } else {
        $oddTotal += $number;
    }
}

echo "Total of all elements: " . $total . "<br>";
echo "Total of even elements: " . $evenTotal . "<br>";
echo "Total of odd elements: " . $oddTotal . "<br><br>";

// Find minimum
$min = min($numbers);

echo "Minimum element: " . $min . "<br>";
echo "Positions of minimum: ";

foreach ($numbers as $position => $number) {
    if ($number == $min) {
        echo $position . " ";
    }
}

echo "<br><br>";

// Find maximum
$max = max($numbers);

echo "Maximum element: " . $max . "<br>";
echo "Positions of maximum: ";

foreach ($numbers as $position => $number) {
    if ($number == $max) {
        echo $position . " ";
    }
}

?>
